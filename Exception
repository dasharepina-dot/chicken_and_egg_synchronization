import java.util.Scanner;

// Checked исключение (подкласс Exception) - требует обязательной обработки (try/catch или throws).
// Обрабатывает ситуацию: вес животного меньше или равен нулю.
class InvalidWeightException extends Exception {
    private double weight;

    public InvalidWeightException(String message, double weight) {
        super(message);
        this.weight = weight;
    }

    public double getWeight() {
        return weight;
    }
}

// Unchecked исключение (подкласс RuntimeException) - обработка необязательна.
// Обрабатывает ситуацию: количество животных меньше нуля.
class NegativeCountException extends RuntimeException {
    private int count;

    public NegativeCountException(int count) {
        super("Количество животных не может быть отрицательным: " + count);
        this.count = count;
    }

    public int getCount() {
        return count;
    }
}

// Класс предметной области (как UserService / BankAccount в примере)
class Zoo {
    public void addAnimal(double weight, int count) throws InvalidWeightException {
        if (weight <= 0) {
            throw new InvalidWeightException("Вес должен быть больше 0", weight);
        }
        if (count < 0) {
            throw new NegativeCountException(count);
        }
        System.out.println("Общий вес: " + weight * count + " кг");
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Zoo zoo = new Zoo();

        try {
            System.out.print("Введите вес животного (кг): ");
            double weight = Double.parseDouble(scanner.nextLine());

            System.out.print("Введите количество животных: ");
            int count = Integer.parseInt(scanner.nextLine()); // проверка типа int

            zoo.addAnimal(weight, count);

        } catch (InvalidWeightException e) {
            System.out.println("Ошибка: " + e.getMessage() + " (введено: " + e.getWeight() + ")");
        } catch (NegativeCountException e) {
            System.out.println("Ошибка: " + e.getMessage());
        } catch (NumberFormatException e) {
            System.out.println("Ошибка: нужно ввести число, а количество должно быть целым (int)");
        }
    }
}
