import java.io.*;
import java.net.HttpURLConnection;
import java.net.URI;
import java.nio.ByteBuffer;
import java.nio.channels.Channels;
import java.nio.channels.ReadableByteChannel;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.nio.file.StandardCopyOption;
import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

public class Main {
    private static final String AllFile = Paths.get("AllFile.txt").toAbsolutePath().toString();

    private static final String Music1 = "https://commons.wikimedia.org/wiki/Special:Redirect/file/All_America_march_%281916_recording%29.mp3";
    private static final String Music2 = "https://archive.org/download/EDIS-SRP-0197-05/EDIS-SRP-0197-05.mp3";
    // placebear.com работает стабильно, а вместо миниатюры Cheetah4.jpg используем прямую ссылку на полноразмерный файл
    private static final String Foto1  = "https://placebear.com/1200/800";
    private static final String Foto2  = "https://upload.wikimedia.org/wikipedia/commons/b/b2/Eagle_nebula_pillars.jpg";

    private static final String PathFile = "all";

    private static final ProcessHandle currentProcess = ProcessHandle.current();
    private static final List<Long> process = new ArrayList<>();
    private static Process Process1, Process2, Process3, Process4;

    public static void main(String[] args) throws IOException {
        System.out.println("Скачивание файлов");
        System.out.println("1. Скачать все файлы и послушать музыку");
        System.out.println("2. Скачать первую песню");
        System.out.println("3. Скачать вторую песню");
        System.out.println("4. Скачать первое фото");
        System.out.println("5. Скачать второе фото");

        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) {
            System.out.println("Нужно ввести число");
            return;
        }
        int input = scanner.nextInt();
        Files.createDirectories(Paths.get(PathFile));

        switch (input) {
            case 1 -> downloading(AllFile, PathFile);
            case 2 -> {
                downloadingOne(Music1, PathFile + File.separator + "music1.mp3");
                Process1 = open(PathFile + File.separator + "music1.mp3", "Первая песня");
            }
            case 3 -> {
                downloadingOne(Music2, PathFile + File.separator + "music2.mp3");
                Process2 = open(PathFile + File.separator + "music2.mp3", "Вторая песня");
            }
            case 4 -> {
                downloadingOne(Foto1, PathFile + File.separator + "foto1.jpg");
                Process3 = open(PathFile + File.separator + "foto1.jpg", "Первое фото");
            }
            case 5 -> {
                downloadingOne(Foto2, PathFile + File.separator + "foto2.jpg");
                Process4 = open(PathFile + File.separator + "foto2.jpg", "Второе фото");
            }
            default -> System.out.println("Нет такого пункта: " + input);
        }

        showProcessInfo();
        scanner.close();
    }

    static void downloading(String listPath, String folder) {
        createFileIfNotExists();
        int count = 0;
        List<String> musicFiles = new ArrayList<>();

        try (BufferedReader reader = new BufferedReader(new FileReader(listPath))) {
            String url;
            while ((url = reader.readLine()) != null) {
                url = url.trim();
                if (url.isEmpty() || url.startsWith("#")) continue;

                boolean isMusic = url.endsWith(".mp3");
                String fileName = folder + File.separator + "file" + count
                        + (isMusic ? ".mp3" : ".jpg");

                try {
                    downloadUsingNIO(url, fileName);
                    System.out.println("Скачано: " + fileName);
                    if (isMusic) musicFiles.add(fileName);
                    count++;
                } catch (IOException e) {
                    System.out.println("Ошибка загрузки " + url + ": " + e.getMessage());
                }
            }
            System.out.println("Всего скачано файлов: " + count);
        } catch (IOException e) {
            System.out.println("Ошибка при чтении файла " + listPath + ": " + e.getMessage());
        }

        if (musicFiles.isEmpty()) {
            System.out.println("Музыка не скачана — нечего включать.");
            return;
        }

        System.out.println("Включаю музыку (" + musicFiles.size() + " файл(а/ов))...");
        List<Process> opened = new ArrayList<>();
        for (int i = 0; i < musicFiles.size(); i++) {
            try {
                Process p = open(musicFiles.get(i), "Музыка #" + (i + 1));
                if (p != null) opened.add(p);
            } catch (IOException e) {
                System.out.println("Не удалось открыть " + musicFiles.get(i) + ": " + e.getMessage());
            }
        }
        if (!opened.isEmpty()) Process1 = opened.get(0);
        if (opened.size() > 1) Process2 = opened.get(1);
    }

    static void downloadingOne(String url, String filePath) {
        try {
            downloadUsingNIO(url, filePath);
            System.out.println("Файл успешно скачан: " + filePath);
        } catch (IOException e) {
            System.out.println("Ошибка при загрузке файла: " + e.getMessage());
        }
    }

    private static void downloadUsingNIO(String strUrl, String file) throws IOException {
        IOException last = null;
        for (int attempt = 1; attempt <= 3; attempt++) {
            try {
                downloadOnce(strUrl, file);
                return;
            } catch (IOException e) {
                last = e;
                System.out.println("  Попытка " + attempt + " не удалась: " + e.getMessage());
                try { Thread.sleep(1000L); } catch (InterruptedException ignored) { }
            }
        }
        throw last;
    }

    private static void downloadOnce(String strUrl, String file) throws IOException {
        HttpURLConnection conn =
                (HttpURLConnection) URI.create(strUrl).toURL().openConnection();

        conn.setRequestProperty("User-Agent",
                "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 " +
                        "(KHTML, like Gecko) Chrome/120.0 Safari/537.36");
        conn.setConnectTimeout(20000);
        conn.setReadTimeout(120000);
        conn.setInstanceFollowRedirects(true);

        Path part = Paths.get(file + ".part");

        try {
            int status = conn.getResponseCode();
            if (status < 200 || status >= 300) {
                throw new IOException("HTTP " + status);
            }

            String ct = conn.getContentType();
            if (ct != null && ct.toLowerCase().startsWith("text/html")) {
                throw new IOException("сервер вернул HTML вместо файла: " + ct);
            }

            try (ReadableByteChannel in = Channels.newChannel(conn.getInputStream());
                 FileOutputStream out = new FileOutputStream(part.toFile())) {

                ByteBuffer buffer = ByteBuffer.allocate(8192);
                while (in.read(buffer) != -1) {
                    buffer.flip();
                    out.getChannel().write(buffer);
                    buffer.clear();
                }
            }

            Files.move(part, Paths.get(file), StandardCopyOption.REPLACE_EXISTING);
        } finally {
            conn.disconnect();
            Files.deleteIfExists(part);
        }
    }

    private static Process open(String filePath, String name) throws IOException {
        File file = new File(filePath);
        if (!file.exists() || file.length() == 0) {
            System.out.println("Файл не найден или пустой: " + filePath);
            return null;
        }

        ProcessBuilder pb = new ProcessBuilder(
                "cmd.exe", "/c", "start", "\"\"", "/wait", filePath);
        Process p = pb.start();
        System.out.println("Открыт файл: " + name + " (PID: " + p.pid() + ")");
        return p;
    }

    private static void showProcessInfo() {
        System.out.println("Информация о процессах:");

        if (Process1 != null && Process1.isAlive()) {
            System.out.println("Процесс 1 — Первая песня, PID: " + Process1.pid());
            process.add(Process1.pid());
        }
        if (Process2 != null && Process2.isAlive()) {
            System.out.println("Процесс 2 — Вторая песня, PID: " + Process2.pid());
            process.add(Process2.pid());
        }
        if (Process3 != null && Process3.isAlive()) {
            System.out.println("Процесс 3 — Первое фото, PID: " + Process3.pid());
            process.add(Process3.pid());
        }
        if (Process4 != null && Process4.isAlive()) {
            System.out.println("Процесс 4 — Второе фото, PID: " + Process4.pid());
            process.add(Process4.pid());
        }

        System.out.println("Текущий PID: " + currentProcess.pid());
        System.out.println("Активен: " + currentProcess.isAlive());
        System.out.println("Дочерних процессов: " + currentProcess.children().count());
        System.out.println("Информация: " + currentProcess.info());
        System.out.println("Список PID процессов: " + process);
    }

    private static void createFileIfNotExists() {
        File file = new File(AllFile);

        boolean needWrite = true;
        if (file.exists()) {
            try {
                String content = Files.readString(file.toPath());
                // Если в файле остались старые нерабочие ссылки — перезаписываем его
                needWrite = content.contains("picsum.photos")
                        || content.contains("unsplash.com")
                        || content.contains("baconmockup.com")
                        || content.contains("thumb/4/4d/Cheetah4");
            } catch (IOException e) {
                needWrite = true;
            }
        }

        if (!needWrite) return;

        try {
            File parent = file.getParentFile();
            if (parent != null) parent.mkdirs();

            try (PrintWriter writer = new PrintWriter(new FileWriter(file))) {
                writer.println(Music1);
                writer.println(Music2);
                writer.println(Foto1);
                writer.println(Foto2);
            }
            System.out.println("Обновлён файл со списком URL: " + AllFile);
        } catch (IOException e) {
            System.err.println("Ошибка создания файла: " + e.getMessage());
        }
    }
}
